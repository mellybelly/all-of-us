.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
*.tmp
# Microsoft Office lock files
~$*

# Large, regenerable raw API caches (rebuildable via the acquisition scripts).
# Derived/analysis outputs and the augmented jsonl ARE tracked; the bulky raw
# XML/JSON responses are not.
resources/peer-biobanks/raw/*_efetch_*.xml
resources/aou-research-landscape/raw/fulltext/
resources/aou-research-landscape/raw/abstracts/
# Regenerable from the raw cache via `fetch_fulltext.py --no-net` (15 MB).
resources/aou-research-landscape/fulltext_augmented.jsonl

# Emerging-trends raw pulls (~2.2 GB preprint+grant JSONL) — regenerable via
# fetch_preprints.py / fetch_grants.py. Derived outputs ARE tracked.
resources/emerging-trends/raw/

# RW-analysis internal-only notes (never publish — pointed interpretation).
resources/rw-analysis/_local_notes.md
resources/rw-analysis/_local_*
